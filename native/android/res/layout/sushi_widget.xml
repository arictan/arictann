<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/sushi_widget_bg">
    <TextView android:id="@+id/sw_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    <ProgressBar android:id="@+id/sw_jar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
        android:progressTint="#FFD34D" android:max="100" />
    <TextView android:id="@+id/sw_tips" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFE2C6" android:textSize="12sp" />
    <TextView android:id="@+id/sw_calendar" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="12sp" />
</LinearLayout>
